# === GESTION PERSONNEL — exemple de configuration ===
# Copiez ce fichier en .env. Ne versionnez jamais les vraies valeurs.

# Flask / sécurité
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-very-long-random-string-32-bytes-minimum
FLASK_ENV=development
FLASK_DEBUG=true
SESSION_COOKIE_SECURE=false
PERMANENT_SESSION_LIFETIME=3600
FORCE_HTTPS=false
TRUSTED_PROXY_COUNT=0
# En production : aucun compte de démonstration, secret initial de 12+ caractères.
SEED_DEMO_DATA=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=

# PostgreSQL et migrations
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gestion_personnel
# true en local/tests ; false en production après le preDeploy Alembic
AUTO_INIT_DB=true
REQUIRE_ALEMBIC_CURRENT=false
SQLALCHEMY_POOL_RECYCLE=300

# Redis / rate limiting partagé
REDIS_URL=redis://localhost:6379/0
RATELIMIT_ENABLED=true
# Optionnel : remplace REDIS_URL uniquement pour Flask-Limiter
RATELIMIT_STORAGE_URI=
RATELIMIT_KEY_PREFIX=gestion-personnel
REQUIRE_REDIS_RATE_LIMIT=false

# Stockage objet S3 compatible (AWS S3, R2, B2, MinIO...)
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_REQUIRED=false
# Les nouveaux fichiers >= 1 Mio sont externalisés ; les petits restent BYTEA.
OBJECT_STORAGE_THRESHOLD_BYTES=1048576
S3_BUCKET=
# AWS : région réelle (ex. eu-west-1) ; Cloudflare R2 : auto
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=gestion-personnel
S3_ADDRESSING_STYLE=auto
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=
HEALTHCHECK_OBJECT_STORAGE=false

# Scheduler : embedded uniquement en développement ; disabled sur le web Render,
# worker dans le service lancé par `python scheduler_worker.py`.
SCHEDULER_MODE=embedded
SCHEDULER_TIMEZONE=Indian/Antananarivo
SCHEDULER_HEARTBEAT_SECONDS=60
SCHEDULER_HEARTBEAT_MAX_AGE=180
REQUIRE_SCHEDULER_HEARTBEAT=false
# Fraîcheur d'un backup S3 applicatif. Laissez false si les sauvegardes sont
# exclusivement gérées par PostgreSQL Render.
BACKUP_MONITORING_ENABLED=false
REQUIRE_BACKUP_FRESHNESS=false
BACKUP_MAX_AGE_SECONDS=129600

# Mail — aucun envoi sans activation explicite
EMAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=gestion.personnel@entreprise.fr
ADMIN_EMAIL=admin@entreprise.fr
EMAIL_POLL_SECONDS=60
EMAIL_BATCH_SIZE=20
EMAIL_MAX_ATTEMPTS=5

# Logs JSON et Sentry
LOG_FORMAT=json
LOG_LEVEL=INFO
SERVICE_NAME=gestion-personnel
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0

# Sauvegarde logique PostgreSQL vers S3 (cron Render)
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups/postgresql
BACKUP_RETENTION_DAYS=30
BACKUP_TIMEOUT_SECONDS=3600
# Les variables BACKUP_S3_* ci-dessous remplacent S3_* si le bucket est distinct.
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_SERVER_SIDE_ENCRYPTION=AES256
BACKUP_S3_KMS_KEY_ID=
# Restauration : URL cible séparée + confirmation destructive explicite.
RESTORE_DATABASE_URL=
RESTORE_CONFIRMATION=RESTAURER-GESTION-PERSONNEL
RESTORE_TIMEOUT_SECONDS=7200
